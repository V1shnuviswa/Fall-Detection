# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WORKERS=4

# Model Configuration
MODEL_PATH=./trained_models/lstm_fall_detector.pth
YOLO_MODEL=yolov8m-pose.pt
DEVICE=cuda  # cuda or cpu

# Detection Thresholds
FALL_THRESHOLD=0.88
POSTURE_THRESHOLD=0.20
MOTION_THRESHOLD=0.15
TEMPORAL_WEIGHT=0.65
POSTURE_WEIGHT=0.20
MOTION_WEIGHT=0.15

# Temporal Settings
BUFFER_SIZE=30  # frames
STRIDE=5  # frames
TARGET_FPS=10

# Physics Validation
MIN_LSTM_PROBABILITY=0.85
MAX_TORSO_ANGLE=30  # degrees
MAX_BBOX_RATIO=1.0
INACTIVITY_THRESHOLD=5  # seconds

# Alert Settings
CONFIRMATION_SECONDS=2
ALERT_TIMEOUT=15  # seconds for human confirmation
MAX_ALERTS_PER_DAY=10

# Camera Settings
FRAME_WIDTH=640
FRAME_HEIGHT=480
JPEG_QUALITY=85

# Database (Optional - for logging)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fall_detection
DB_USER=postgres
DB_PASSWORD=

# Redis (Optional - for scaling)
REDIS_HOST=localhost
REDIS_PORT=6379

# Alert Channels
ENABLE_EMAIL=false
ENABLE_SMS=false
ENABLE_WEBHOOK=false
WEBHOOK_URL=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
ALERT_PHONE=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/fall_detection.log

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SECRET_KEY=change-this-in-production

# Monitoring (Optional)
ENABLE_METRICS=true
METRICS_PORT=9090

# Privacy
SAVE_POSES=false  # Save pose data for debugging
SAVE_IMAGES=false  # Never enable in production
DATA_RETENTION_DAYS=7
